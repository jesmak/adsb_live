{
    "name": "adsb-receiver-card",
    "description": "The dashboard card that comes with the ADS-B Live integration, for the state of a receiver: whether it hears anything, the aircraft tracked over a day, its range, signal against noise and other feeders",
    "keywords": [
        "home-assistant",
        "homeassistant",
        "hass",
        "lovelace",
        "custom-cards",
        "ads-b",
        "readsb"
    ],
    "type": "module",
    "private": true,
    "license": "MIT",
    "repository": "git@github.com:jesmak/adsb_live.git",
    "engines": {
        "node": ">=22.13"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
    },
    "dependencies": {
        "lit": "^3.3.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "happy-dom": "^21.0.3",
        "prettier": "^3.9.6",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
